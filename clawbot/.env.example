# Clawbot Money Engine - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Admin Authentication
ADMIN_PASSWORD=change_me_secure_password
AGENT_SECRET=your_random_agent_secret_for_api

# OpenAI API (for AI content generation)
OPENAI_API_KEY=sk-your-openai-api-key

# GitHub Auto Push
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=mukithc/clawbot-money-engine
GITHUB_BRANCH=main

# Domain (for sitemap, canonical URLs)
SITE_URL=https://bot.hub-depot.com

# Deploy script (optional - for creating GitHub repo via API)
# GITHUB_TOKEN=ghp_xxx  # Create at github.com/settings/tokens
