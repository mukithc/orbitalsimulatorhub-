{
  "name": "satellite-simulator-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n v,api \"vite\" \"node --import tsx server/_core/api-only.ts\"",
    "dev:3002": "concurrently -n v,api \"cross-env PORT=3002 API_PORT=3003 vite\" \"cross-env PORT=3003 node --import tsx server/_core/api-only.ts\"",
    "dev:single": "node --import tsx server/_core/index.ts",
    "dev:3001": "cross-env PORT=3001 node --import tsx server/_core/index.ts",
    "dev:vite": "vite",
    "dev:api": "node --import tsx server/_core/api-only.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:client": "npm run generate:rss && vite build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html','dist/404.html'))\"",
    "generate:rss": "node scripts/generate-rss.js",
    "generate:post": "node scripts/generate-blog-post.js",
    "auto-deploy": "node scripts/auto-deploy-after-post.js",
    "setup": "node scripts/setup-everything.js",
    "verify": "node scripts/verify-setup.js",
    "complete": "node scripts/complete-setup.js",
    "start": "node dist/server/_core/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:main-site": "node scripts/run-main-site-tables.js",
    "content:generate": "node scripts/content-agent.js",
    "content:dry-run": "node scripts/content-agent.js --dry-run",
    "content:schedule": "node scripts/content-scheduler.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.0",
    "@react-three/fiber": "^9.0.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@vercel/analytics": "^1.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.0",
    "three": "^0.170.0",
    "wouter": "^2.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.28.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
